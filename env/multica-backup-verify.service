[Unit]
Description=Verify the latest Multica backup with a temporary database restore
Wants=network-online.target
After=network-online.target kube-apiserver.service etcd.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=MULTICA_BACKUP_ROOT=/home/multica-backups
ExecStart=/usr/local/sbin/multica-backup-verify
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
